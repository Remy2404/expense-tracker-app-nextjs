# =========================
# Next.js Web App Environment
# =========================
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_AI_API_URL=""
NEXT_PUBLIC_AI_API_TIMEOUT_MS="20000"
# Optional: comma-separated extra origins for CSP connect-src (origins only, no paths)
NEXT_PUBLIC_CSP_CONNECT_SRC_EXTRA=""
# Optional: explicit realtime socket endpoint exposed to browser (CSP + client usage)
NEXT_PUBLIC_REALTIME_SOCKET_URL=""
NEXT_PUBLIC_REALTIME_RELAY_URL=""
# Optional: allow script eval in non-dev runs only when required by trusted tooling
CSP_ALLOW_UNSAFE_EVAL="false"

# Supabase (client-safe keys)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Firebase Web (client config)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_web_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id"

# Realtime relay (used by scripts/dev-with-relay.mjs and scripts/realtime-relay.mjs)
RELAY_PORT="8090"
PORT="8090"
RELAY_SECRET="replace_with_strong_secret"
REALTIME_RELAY_SECRET="replace_with_strong_secret"
RELAY_ALLOWED_ORIGIN="http://localhost:3000"
REALTIME_RELAY_URL="http://localhost:8090"
REALTIME_PUBLIC_SOCKET_URL="http://localhost:8090"
